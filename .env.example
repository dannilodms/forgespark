# Every variable of the system, with values that work in development as they
# are. Nothing here is a real secret.
#
# Task loads `.env` first and this file for what `.env` lacks, and passes the
# variables to Compose, so development runs without a `.env`. To change a
# value, write it in a `.env`.
# Rules: Configuration and Development in CODING_STANDARDS.md.

# --- The PostgreSQL container (Compose) ---

# Port of the machine that reaches PostgreSQL.
POSTGRES_PORT=5432
# Password of the superuser, `postgres`. Only the tests use it, to create
# their temporary databases.
POSTGRES_PASSWORD=postgres
# Passwords of the two roles the container creates on its first start.
POSTGRES_MIGRATION_PASSWORD=migration
POSTGRES_API_PASSWORD=api

# --- The API binary ---

# Where the API listens, as host:port. An empty host is every interface.
API_LISTEN_ADDRESS=127.0.0.1:8080
# Connection of the API role, which reads and writes rows. Required by the API.
DATABASE_URL=postgres://api:api@localhost:5432/software_factory?sslmode=disable
# Connection of the migration role, which owns the tables. Required by `migrate`.
MIGRATION_DATABASE_URL=postgres://migration:migration@localhost:5432/software_factory?sslmode=disable
# The most connections the pool of the API opens. Default: 10.
DATABASE_POOL_MAX_SIZE=10
# How long one statement may run. Default: 30s.
DATABASE_STATEMENT_TIMEOUT=30s
# How long a transaction may sit idle. Default: 1m.
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT=1m
# How long the check of a part may take, readiness included. Default: 2s.
HEALTH_CHECK_TIMEOUT=2s

# --- The Go tests ---

# Connection of a superuser. Each test that needs PostgreSQL creates its own
# temporary database with it and removes it at the end.
TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable
