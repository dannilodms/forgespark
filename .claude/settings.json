{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/checkout-state.js\"",
            "timeout": 40,
            "statusMessage": "Checking the checkout against origin"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/staging-question.js\"",
            "timeout": 10,
            "statusMessage": "Checking the staging question"
          }
        ]
      }
    ]
  }
}
